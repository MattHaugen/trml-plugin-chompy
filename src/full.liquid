<div class="layout">
  <div class="columns">
    {% for day in days %}
    <div class="column">
      <span class="title title--large">{{ day.date | date: "%A" }}</span>
      <span class="title title--small">{{ day.date | date: "%b %e, %Y"}}</span>
      <div class="grid">
        <div class="col">
          <div class="h--[50cqh]">{% for station in day.breakfast %}
            <img class="image image-dither image--contain rounded h--20" src="{{ station.image }}" />

            <div class="item">
              <div class="content">
                <span class="title title--small">{{ station.name }}</span>
                <div class="flex flex--col flex--left">
                  {% for entree in station.entrees %}
                  <span class="label label--small text--left">{{ entree }}</span>
                  {% endfor %}
                </div>
                <span class="description">{{ station.sides | join: ", " }}</span>
              </div>
            </div>
            {% endfor %}</div>
          <div class="h--[50cqh]">{% for station in day.lunch %}
            <img class="image image-dither rounded image--contain rounded h--20" src="{{ station.image }}" />

            <div class="item">
              <div class="content">
                <span class="title title--small">{{ station.name }}</span>
                <div class="flex flex--col flex--left">
                  {% for entree in station.entrees %}
                  <span class="label label--small text--left">{{ entree }}</span>
                  {% endfor %}
                </div>
                <span class="description">{{ station.sides | join: ", " }}</span>
              </div>
            </div>
            {% endfor %}</div>
        </div>
      </div>


    </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg" />
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{ trmnl.plugin_settings.custom_fields_values.district_id | upcase }} | {{ trmnl.plugin_settings.custom_fields_values.school_id | upcase }}</span>
</div>
